# Cloudflare Pages routing.
#
# Real files win first, so the static pages generated by scripts/build-seo.mjs
# (list/index.html, information/index.html, …) answer their own URLs with the
# right <title>, description, canonical link and no-JavaScript content.
# /home duplicates the root, so it is redirected rather than indexed twice.
/home            /              301

# Anything else — /mobile/*, /generator, /admin, unknown URLs — falls through to
# the SPA shell and is handled by the Vue router (200 = rewrite, URL unchanged).
# seo:redirects:start
# seo:redirects:end

/*    /index.html    200
